# workout-bot configuration
#
# Copy this file to `.env` and fill in the values:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed. This file is the committed
# template — keep every value below empty or an obvious placeholder.
#
# Both names below are the Anthropic SDK's own environment variables, so a
# zero-argument `anthropic.Anthropic()` picks them up automatically.

# Required. Your Claude API key, from https://console.anthropic.com/settings/keys
# Starts with `sk-ant-`.
ANTHROPIC_API_KEY=

# Optional. The API endpoint. Leave empty for the public Claude API
# (https://api.anthropic.com); set it to route through a gateway, proxy, or
# region-specific endpoint. Empty and unset are treated identically.
ANTHROPIC_BASE_URL=
