# Copy to `.env` (gitignored) when running the `colab` CLI on your own machine.
# In a Claude Code cloud session the token is injected by the environment instead.

# The URL printed by colab/bridge.ipynb, e.g. https://name-words.ngrok-free.app
COLAB_URL=

# The BRIDGE_TOKEN you stored in Colab's Secrets panel. Never commit it.
COLAB_TOKEN=
